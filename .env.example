# Copy to .env and fill in. Every setting has a sensible default.

# First-run administrator, created once on an empty database. Leave blank to create the
# first account from the sign-in page instead. Passwords need 10+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Where things live on the NAS (docker-compose bind mounts) ----
# database and artwork cache
DATA_DIR=/volume1/docker/mediawan/data
# mounted read-only at /media
MEDIA_DIR=/volume1/media
# temporary HLS segments
TRANSCODE_DIR=/volume1/docker/mediawan/transcode

# Library folders INSIDE the container, separated by ":". A folder named like
# Movies, TV, Shows or Anime tells the scanner what to expect inside it.
LIBRARY_ROOTS=/media/Movies:/media/TV:/media/Anime

# ---- Playback ----
# qsv = Intel QuickSync (the N100), vaapi = generic VA-API, none = software x264.
# Only used when video must be re-encoded; copying streams never touches the GPU.
HWACCEL=qsv
# Simultaneous re-encodes. Stream copies (remux) get four times as many slots.
MAX_TRANSCODES=2
# GIDs that own /dev/dri on the NAS: stat -c '%g %G %n' /dev/dri/*
VIDEO_GID=44
RENDER_GID=105

# ---- Library ----
# rescan every 6 hours (0 = only at startup and on demand)
SCAN_INTERVAL_SECONDS=21600
# false = never contact Cinemeta; titles keep their folder names
METADATA_ONLINE=true
# Anime search and streaming from AniList + MegaPlay (false = off)
ONLINE_ANIME=true
# Online movies and TV over BitTorrent, through the vpn service (needs --profile vpn, which
# also starts the torrent service). Generate the key with: openssl rand -hex 32
# TORRENT_URL=http://vpn:8792
# TORRENT_KEY=
# Release groups the streaming filter trusts (Settings > Playback turns the filter on or off per
# person). Empty = the built-in list in release_rules.py (NTb, FLUX, CMRG, SubsPlease...).
# TORRENT_TRUSTED_GROUPS=NTb,FLUX,CMRG
# Season downloads of TV shows (Admin > Downloads, and Download season on a show page) are
# saved into the library's TV folder, mounted writable at /downloads in docker-compose.yml.
# Set it empty to turn season downloads off.
# DOWNLOAD_DIR=/downloads
# Torrent cache (under TRANSCODE_DIR/torrents): its cap, and the free space always kept
# TORRENT_CACHE_GB=60
# TORRENT_MIN_FREE_GB=10
# TORRENT_UPLOAD_KBPS=1024
# Only if the tunnel is not tun*/wg*, or if peers never connect with the binding on:
# TORRENT_INTERFACE=tun0
# TORRENT_BIND_TUNNEL=true
# Subtitle languages offered on every title (two-letter codes). Missing ones are translated
# by the libretranslate service; also list them in LT_LOAD_ONLY (keep en there).
SUBTITLE_LANGUAGES=ar,da,pt
LT_LOAD_ONLY=en,ar,da,pt
# CINEMETA_BASE=https://v3-cinemeta.strem.io

# ---- Live sports ----
# The IPTV provider is added in Admin → Live TV; its login is saved in LIVE_TV_DIR, not here.
LIVE_TV=true
# LIVE_TV_DIR=/data/live-tv
# XMLTV guides matched to your channels (comma-separated). Default: epgshare01 UK1, DE1, NL1, BEIN1
# LIVE_GUIDES=https://epgshare01.online/epgshare01/epg_ripper_UK1.xml.gz,https://epgshare01.online/epgshare01/epg_ripper_BEIN1.xml.gz
# Fixtures and scores from ESPN (false = guide programmes only)
LIVE_FIXTURES=true

# ---- Network ----
PORT=8787
# true when every visit comes over HTTPS (e.g. the tunnel only)
COOKIE_SECURE=false
# Proxies allowed to set X-Forwarded-For. Use * only if the port is not reachable directly.
FORWARDED_ALLOW_IPS=127.0.0.1
# Cloudflare tunnel: docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# Optional: drop root inside the container (the uid must own DATA_DIR and TRANSCODE_DIR)
# PUID=1000
# PGID=1000
# ---- Optional NordVPN tunnel (docker compose --profile vpn up -d vpn) ----
# The login itself is NOT set here: run  sudo ./vpn-credentials.sh  on the NAS, which asks
# for it without showing it and saves it in VPN_SECRETS_DIR, readable by root only.
# NORDVPN_TYPE=openvpn          # openvpn (service credentials) or wireguard (NordLynx key)
# NORDVPN_COUNTRY=Netherlands
# VPN_SECRETS_DIR=./vpn-secrets
