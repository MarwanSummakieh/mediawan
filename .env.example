# First administrator is created only for an empty database.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# A minimum of ten characters is required. No default account is created.
REAL_DEBRID_TOKEN=
# Optional direct-torrent engine. qBittorrent 5.2+ is tested.
QBIT_URL=
QBIT_USERNAME=
QBIT_PASSWORD=
# qBittorrent's path and Mediawan's local path must map to the same folder.
QBIT_SAVE_PATH=/downloads
TORRENT_DIR=./media/torrents
# V2 intentionally does not consume DB_PATH from v1.
MEDIAWAN_DB=./data/mediawan-v2.sqlite
LIBRARY_DIR=./media/library
TRANSCODE_DIR=./transcode
PORT=8787
LAN_PORT=8788
HOST=0.0.0.0
COOKIE_SECURE=false
TRUST_PROXY=0
# Approved import folders; separated by ; on Windows and : on Linux.
IMPORT_ROOTS=
CACHE_MAX_DOWNLOADS=2
# Space kept free after new downloads; old app-managed titles are reclaimed automatically.
# Any user's favorite, active playback, pending downloads and imported files are protected.
CACHE_RESERVE_BYTES=21474836480
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Saved IPTV channel configuration and guide. Defaults to live-tv beside MEDIAWAN_DB.
LIVE_TV_DIR=./data/live-tv
CINEMETA_BASE=https://v3-cinemeta.strem.io
TORRENTIO_BASE=https://torrentio.strem.fun
# Docker bind mounts and optional tunnel.
DATA_DIR=./data
MEDIA_DIR=./media
PUID=1000
PGID=1000
TUNNEL_TOKEN=
