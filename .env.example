# First administrator is created only for an empty database.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# A minimum of ten characters is required. No default account is created.
REAL_DEBRID_TOKEN=
# Optional direct-torrent engine. qBittorrent 5.2+ is tested.
QBIT_URL=
QBIT_USERNAME=
QBIT_PASSWORD=
# qBittorrent's path and Mediawan's local path must map to the same folder.
QBIT_SAVE_PATH=/downloads
TORRENT_DIR=./media/torrents
# V2 intentionally does not consume DB_PATH from v1.
MEDIAWAN_DB=./data/mediawan-v2.sqlite
LIBRARY_DIR=./media/library
TRANSCODE_DIR=./transcode
PORT=8787
LAN_PORT=8788
HOST=0.0.0.0
COOKIE_SECURE=false
TRUST_PROXY=0
# Approved import folders; separated by ; on Windows and : on Linux.
IMPORT_ROOTS=
CACHE_MAX_DOWNLOADS=2
# Space kept free after new downloads; old app-managed titles are reclaimed automatically.
# Any user's favorite, active playback, pending downloads and imported files are protected.
CACHE_RESERVE_BYTES=21474836480
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Stream now (watch while downloading). See docs/streaming.md.
# By default no torrent traffic starts unless a VPN interface is up, and streams stop if
# it disappears. STREAM_VPN=off disables the check (peers then see your address).
STREAM_VPN=required
# Interface names that count as a VPN; * is a wildcard. Behind a VPN container (Gluetun
# and similar) the app sees tun0 or wg0, which the default list already matches.
# Limits: only the interface NAME is checked and traffic is not bound to it. Another
# interface with a matching name (e.g. a home remote-access wg0) passes the check while
# torrents use the normal route, so list only your VPN adapter if you have one. A drop is
# noticed within about 0.5 s. For a hard guarantee use the VPN kill switch (Windows) or run
# the app inside the VPN container's network namespace (NAS). See docs/streaming.md.
STREAM_VPN_INTERFACES=nordlynx,nordvpn*,wireguard*,openvpn*,proton*,mullvad*,wg*,tun*,tap*
# Stream sessions on the server at once (one per device or player, prepared ones included;
# idle prepared ones are evicted first; failed ones do not count). Each user: at most 4.
STREAM_MAX_SESSIONS=6
# Disk the stream cache may commit (a stream reserves twice its file size). CACHE_RESERVE_BYTES
# above also applies: a stream only starts if the disk keeps that much free.
STREAM_CACHE_BYTES=107374182400
STREAM_UPLOAD_KBPS=1024
# Seconds without metadata before the next-ranked release is raced against the first.
STREAM_FALLBACK_SECONDS=6
STREAM_DHT=true
# Extra comma-separated trackers announced for every stream.
STREAM_TRACKERS=
# Saved IPTV channel configuration and guide. Defaults to live-tv beside MEDIAWAN_DB.
LIVE_TV_DIR=./data/live-tv
CINEMETA_BASE=https://v3-cinemeta.strem.io
TORRENTIO_BASE=https://torrentio.strem.fun
# Docker bind mounts and optional tunnel.
DATA_DIR=./data
MEDIA_DIR=./media
PUID=1000
PGID=1000
TUNNEL_TOKEN=
